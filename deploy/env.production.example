# ============================================================
#  .env de PRODUCCIÓN (VPS) — copiar a /home/erpjamaroff/erp-jamaroff/.env
#  Cambia TODO lo que dice CAMBIAR. Nunca subas este archivo a GitHub.
# ============================================================

# Docker: nombre propio para que no choque con otros proyectos del VPS
COMPOSE_PROJECT_NAME=erp-jamaroff

# Base de datos (contenedor propio, solo en 127.0.0.1)
POSTGRES_PORT=5441
POSTGRES_USER=erp
POSTGRES_PASSWORD=CAMBIAR-clave-larga-de-la-base
POSTGRES_DB=erp
# Debe calzar con los 4 valores de arriba
DATABASE_URL=postgres://erp:CAMBIAR-clave-larga-de-la-base@127.0.0.1:5441/erp

# Puertos internos (Nginx los publica en https://erp.jamaroff.cl)
API_PORT=4101
WEB_PORT=3101

# Dominio
WEB_ORIGIN=https://erp.jamaroff.cl
NEXT_PUBLIC_API_URL=https://erp.jamaroff.cl/api

# Sesiones: genera el secreto con   openssl rand -base64 48
AUTH_SECRET=CAMBIAR
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR-clave-del-admin-inicial
SESSION_DAYS=7
COOKIE_SECURE=true

NODE_ENV=production
# Boletas en el SII (portal eBoleta) vía API Gateway — https://www.apigateway.cl
# Token de la conexión en API Gateway + RUT y clave tributaria de la EMPRESA
APIGATEWAY_TOKEN=CAMBIAR
SII_EMISOR_RUT=CAMBIAR-76123456-7
SII_EMISOR_CLAVE=CAMBIAR
