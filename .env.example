# Puertos propios de este proyecto (distintos a los típicos para no chocar
# con otros proyectos que tengas corriendo). Docker Compose los lee de aquí.
POSTGRES_PORT=5440
REDIS_PORT=6390

# Base de datos (el puerto debe coincidir con POSTGRES_PORT)
DATABASE_URL=postgres://erp:erp@localhost:5440/erp

# Redis (se usará para las colas de BullMQ al procesar archivos)
REDIS_URL=redis://localhost:6390

# API (NestJS)
API_PORT=4100
WEB_ORIGIN=http://localhost:3100

# Frontend (Next.js corre en el puerto 3100)
WEB_PORT=3100
NEXT_PUBLIC_API_URL=http://localhost:4100/api

